# Thari - Handloom D2C Platform Configuration

# Application settings
APP_NAME=Thari
APP_TITLE="Thari - Handloom Weavers D2C Platform"
APP_DESCRIPTION="Direct-to-Consumer platform connecting heritage Indian handloom weavers directly with conscious consumers."
APP_VERSION=1.0.0
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000

# Fair Trade Share & Pricing Policy
MIN_ARTISAN_SHARE_PERCENT=75.0
DEFAULT_ARTISAN_SHARE_PERCENT=82.0
PLATFORM_FEE_PERCENT=5.0

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Optional external integrations
ENABLE_SIMULATED_ESCROW=True
ENABLE_SAMPLE_DATA_SEEDING=True
